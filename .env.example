# Copiá este archivo a .env (nunca se commitea). En local todo tiene valores por defecto.
ENTORNO=local
PORT=3101
# Pedidos por minuto y por usuario (límite de la API).
RATE_LIMIT_POR_MINUTO=120
# Obligatorias fuera de local:
PLATFORM_JWKS_URL=http://127.0.0.1:8080/.well-known/jwks.json
PLATFORM_ISSUER=http://localhost:8080
