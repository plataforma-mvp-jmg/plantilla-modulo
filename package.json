{
  "name": "plantilla-modulo",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "description": "Plantilla homologada de módulos de la plataforma (MVP, datos sintéticos).",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "vendor:check": "node scripts/verificar-vendor.mjs",
    "verify": "pnpm vendor:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.2",
    "fastify": "5.12.8",
    "jose": "6.2.17",
    "pg": "8.23.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
